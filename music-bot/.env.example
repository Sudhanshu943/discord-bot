# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# ==================== PROXY CONFIGURATION (ANTI-BOT DETECTION) ====================
# Single proxy URL (optional)
# Format: http://[user:pass@]proxy_host:port or https://...
PROXY_URL=

# Multiple proxies for rotation (optional, separated by semicolon)
# PROXY_LIST=http://proxy1:8080;http://proxy2:8080;http://proxy3:8080
PROXY_LIST=

# Enable proxy rotation (true/false)
PROXY_ROTATION=false

# ==================== YOUTUBE CONFIGURATION ====================
# YouTube cookie URL (optional - for age-restricted content)
YOUTUBE_COOKIE_URL=

# ==================== RAILWAY/DEPLOYMENT CONFIGURATION ====================
# For Railway deployment, use HTTP proxy like:
# PROXY_URL=http://proxy.provider:port
# Example with free proxy service:
# PROXY_URL=http://proxy-free-service:8000

# ==================== EXAMPLES ====================
# 1. Using ScraperAPI proxy (recommended for YouTube):
#    PROXY_URL=http://api_key:@proxy-server.scraperapi.com:8001

# 2. Using free-proxy-list services:
#    PROXY_URL=http://10.10.1.10:3128

# 3. Using Bright Data (formerly Luminati):
#    PROXY_URL=http://customer-username-sessionid:zone_name@proxy.provider.com:port

# 4. No proxy (use default):
#    PROXY_URL=
