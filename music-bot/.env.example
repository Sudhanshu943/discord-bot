# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here

# Optional: Proxies (comma-separated list)
# Format: proxy1.com:port,proxy2.com:port
# Leave empty to use direct connection
PROXIES=

# Optional: Sentry for error tracking
SENTRY_DSN=

# Optional: Custom log level
LOG_LEVEL=INFO

# Bot Settings
BOT_PREFIX=!
BOT_COMMAND_TIMEOUT=60

# YouTube Settings (yt-dlp)
YDL_SOCKET_TIMEOUT=20
YDL_RETRIES=3

# Railway-specific
RAILWAY_ENVIRONMENT=production
